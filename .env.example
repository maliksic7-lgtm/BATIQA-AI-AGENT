# BATIQA AI Guest Assistant - Environment Variables
# Copy to .env and fill real values. Never commit .env with secrets.

# Server
PORT=8080
ENV=development
# Options: development, production

# Database (Phase 2)
DB_DSN=root:password@tcp(127.0.0.1:3306)/batiqa_ai?parseTime=true&charset=utf8mb4
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# AI Provider (Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
AI_PROVIDER=gemini
# Options: gemini, openai, mock

# Logging
LOG_LEVEL=info
# Options: debug, info, warn, error
