# BATIQA AI Guest Assistant - Environment Variables
# Copy to .env and fill real values. Never commit .env with secrets.

# Server
PORT=8080
ENV=development
# Options: development, production

# Database (MySQL)
DB_DSN=root:batiqa@tcp(127.0.0.1:3306)/batiqa_ai?parseTime=true&charset=utf8mb4&loc=Local
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# AI Provider
AI_PROVIDER=gemini
# Options: gemini, mock (mock = rule-based fallback, no external API needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS: comma-separated allowed origins, or * for all (dev only)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Logging
LOG_LEVEL=info
# Options: debug, info, warn, error

# Docker Compose (MySQL container)
MYSQL_ROOT_PASSWORD=batiqa
